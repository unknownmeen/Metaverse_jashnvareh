// ─────────────────────────────────────────────────────────────
// Building (Festivals) — Prisma Schema
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  JUDGE
  JUDGE_LEVEL_1
  JUDGE_LEVEL_2
  JUDGE_LEVEL_3
  USER
}

enum Gender {
  MALE
  FEMALE
}

enum FestivalStatus {
  UNOPENED
  OPEN
  CLOSED
}

enum ConceptMediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  COMMENT
  RATING
  SYSTEM
  TOP_IMAGE
}

enum RatingCategory {
  USER
  JUDGE
}

// ── Models ───────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  passwordHash String
  role         Role     @default(USER)
  judgeLevel   Int?
  gender       Gender
  realName     String?
  displayName  String?
  avatarUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images                Image[]
  comments              Comment[]
  ratings               Rating[]
  createdFestivals      Festival[]      @relation("FestivalCreator")
  notifications         Notification[] @relation("ReceiverNotifications")
  sentNotifications     Notification[] @relation("SenderNotifications")

  @@map("users")
}

model Festival {
  id               String           @id @default(uuid())
  slug             String           @unique
  name             String
  coverImageUrl    String?
  conceptMediaType ConceptMediaType @default(IMAGE)
  conceptMediaUrl  String?
  conceptText      String?
  rulesText        String?
  status           FestivalStatus   @default(UNOPENED)

  creatorId String?
  creator   User? @relation("FestivalCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images Image[]

  @@map("festivals")
}

model Image {
  id         String  @id @default(uuid())
  slug       String  @unique
  url        String
  galleryUrls String[] @default([])
  title      String?
  description String?
  isTopImage Boolean @default(false)
  tags       String[] @default([])

  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  ratings  Rating[]

  @@map("images")
}

model Comment {
  id            String  @id @default(uuid())
  text          String
  isAdminReview Boolean @default(false)
  isJudgeReview Boolean @default(false)
  ratingScore   Int?
  ratingMaxScore Int?

  imageId String
  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentCommentId String?
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

model Rating {
  id    String @id @default(uuid())
  score Int
  maxScore Int @default(5)
  category RatingCategory @default(USER)

  imageId String
  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([imageId, userId, category])
  @@map("ratings")
}

model Notification {
  id     String           @id @default(uuid())
  type   NotificationType
  text   String
  isRead Boolean          @default(false)

  userId   String
  user     User   @relation("ReceiverNotifications", fields: [userId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?  @relation("SenderNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  imageId String?
  festivalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model Release {
  id           String   @id @default(uuid())
  version      String   @unique
  published    Boolean  @default(false)
  publishedAt  DateTime?
  features     String[] @default([])
  improvements String[] @default([])
  bugFixes     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("releases")
}
